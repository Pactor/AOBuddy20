{
  "_description": "Anarchy Online implant system reference: the fixed cluster-to-slot mapping (which skill/ability clusters are available in each slot's Shiny/Bright/Faded position), equip-requirement model, cluster QL rules, and build (Nano Programming) requirements. Slot ids match AOSharp.Common.GameData.EquipSlot Imp_* entries. Cluster names are sourced verbatim; _clusterStatMap joins them to AOSharp.Common.GameData.Stat.",
  "_grades": {
    "Shiny": "Highest bonus, hardest to combine. Must be >= 86% of implant QL.",
    "Bright": "~60% of the Shiny bonus. Must be >= 84% of implant QL.",
    "Faded": "~40% of the Shiny bonus, easiest to combine. Must be >= 82% of implant QL."
  },
  "_clusterInvariant": "Across all 13 Shiny sets, each skill/ability cluster occurs exactly once; likewise for the 13 Bright sets and the 13 Faded sets. So each cluster has exactly one legal (slot, grade) home.",
  "equipRequirementModel": {
    "_summary": "To equip an implant of quality level QL you need both a Treatment skill value and one governing Ability value at or above the thresholds below. The governing ability differs per implant line (e.g. an ability/health implant is gated by that ability). Exact per-item requirements are stored in the item itself (local items.dat) and should be read from there when precision matters.",
    "treatmentRequired": {
      "exactFormula": "trunc(4.723717064 * QL + 6.767295257)",
      "approxFormula": "QL * 4.7 + 11",
      "note": "Treatment multiplier drifts from just over 5x QL at QL2 to ~4.75x QL at QL200. QL200 implant ~ 947 Treatment."
    },
    "abilityRequired": {
      "formula": "QL * 2 + 4",
      "note": "Base governing-ability requirement; QL200 implant ~ 404 of the governing ability."
    },
    "ladderingConcept": "You can equip a higher-QL implant than your raw skills allow by 'laddering': equip lower-QL implants and cast/wear Treatment- and ability-buffs (and use over-equip via the item's own tolerance) to temporarily inflate Treatment and the governing ability, equip the target implant, then swap the ladder pieces up one QL at a time. Tools like AOLadderer / Auno Implant Designer automate the sequence."
  },
  "clusterBuildRequirement": {
    "_summary": "Nano Programming skill needed to assemble a cluster into an implant, scaling with cluster QL and a per-skill multiplier.",
    "shiny": "2.0 * skillMultiplier * QL",
    "bright": "1.5 * skillMultiplier * QL",
    "faded": "1.0 * skillMultiplier * QL",
    "note": "skillMultiplier depends on which skill the cluster grants (some skills are 'harder' clusters). Exact multipliers per skill are in the cluster tables of the source guides; not reproduced here."
  },
